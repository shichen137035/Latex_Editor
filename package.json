{
  "name": "latex-editor",
  "version": "0.7.0",
  "main": "apps/desktop/dist/main/index.js",
  "private": true,
  "author": "Shi Chen",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Local-first LaTeX editor foundation",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b --pretty false && tsc -p tests/types/tsconfig.json --pretty false",
    "lint": "eslint .",
    "i18n:check": "node apps/desktop/scripts/i18n-audit.mjs",
    "desktop:test-i18n": "npm run desktop:build && node apps/desktop/scripts/run-electron-check.mjs i18n",
    "test": "node tests/validate-catalog.mjs && vitest run",
    "test:catalog": "node tests/validate-catalog.mjs",
    "test:unit": "node tests/validate-catalog.mjs && vitest run --project unit",
    "test:unit:domain": "node tests/validate-catalog.mjs && node tests/run-unit-domain.mjs",
    "test:unit:ai": "npm run test:unit:domain -- ai",
    "test:unit:editor": "npm run test:unit:domain -- editor",
    "test:unit:preview": "npm run test:unit:domain -- preview",
    "test:unit:projects": "npm run test:unit:domain -- projects",
    "test:unit:references": "npm run test:unit:domain -- references",
    "test:unit:compiler": "npm run test:unit:domain -- compiler",
    "test:unit:settings": "npm run test:unit:domain -- settings",
    "test:integration": "node tests/validate-catalog.mjs && vitest run --project integration",
    "test:compiler": "node tests/validate-catalog.mjs && vitest run --project compiler",
    "test:cli": "node tests/validate-catalog.mjs && vitest run --project cli-e2e",
    "test:debug": "node tests/validate-catalog.mjs && vitest run --reporter=verbose --no-file-parallelism",
    "resources:validate": "tsx apps/cli/src/index.ts resources validate",
    "capabilities:build": "tsc -b apps/desktop/tsconfig.main.json --pretty false && node apps/desktop/scripts/build-capabilities.cjs",
    "doctor": "tsx apps/cli/src/index.ts doctor",
    "cli": "tsx apps/cli/src/index.ts",
    "clean:build": "node apps/desktop/scripts/clean-build.cjs",
    "desktop:typecheck": "npm exec tsc -- -p apps/desktop/tsconfig.json --noEmit --pretty false",
    "desktop:build": "npm run clean:build && npm run typecheck && npm run desktop:typecheck && vite build --config apps/desktop/vite.config.ts && tsc -p apps/desktop/tsconfig.main.json && node apps/desktop/scripts/build-preload.cjs",
    "desktop:dist:win": "npm run verify:release && node apps/desktop/scripts/build-distribution.cjs --skip-build",
    "desktop:package:win": "node apps/desktop/scripts/build-distribution.cjs",
    "desktop:package:nsis": "node apps/desktop/scripts/build-distribution.cjs --target=nsis",
    "desktop:dist:nsis": "npm run verify:release && node apps/desktop/scripts/build-distribution.cjs --target=nsis --skip-build",
    "desktop:verify:package": "node apps/desktop/scripts/verify-package.cjs",
    "desktop:dev": "node apps/desktop/scripts/dev.cjs",
    "desktop:dev:build": "npm run desktop:build && node apps/desktop/scripts/launch.cjs",
    "desktop:test-check-list": "node apps/desktop/scripts/run-electron-check.mjs --list",
    "desktop:test-check": "npm run desktop:build && node apps/desktop/scripts/run-electron-check.mjs",
    "desktop:test-regression": "npm run desktop:build && node apps/desktop/scripts/run-electron-check.mjs release",
    "desktop:test-ai": "npm run desktop:build && node apps/desktop/scripts/run-electron-check.mjs ai-connection",
    "desktop:test-ai-attachments": "npm run desktop:build && node apps/desktop/scripts/run-electron-check.mjs ai-attachments",
    "desktop:test-ai-review": "npm run desktop:build && node apps/desktop/scripts/run-ai-review-check.mjs",
    "desktop:test-structure": "npm run desktop:build && node apps/desktop/scripts/run-structure-check.mjs",
    "desktop:test-ui": "npm run desktop:build && node apps/desktop/scripts/run-file-menu-check.mjs",
    "desktop:test-history": "npm run desktop:build && node apps/desktop/scripts/run-history-check.mjs",
    "desktop:test-preview": "npm run desktop:build && node apps/desktop/scripts/run-preview-check.mjs",
    "desktop:test-preview-caret": "npm run desktop:build && node apps/desktop/scripts/run-electron-check.mjs preview-caret",
    "desktop:test-preview-navigation": "npm run desktop:build && node apps/desktop/scripts/run-electron-check.mjs preview-navigation",
    "desktop:test-references": "npm run desktop:build && node apps/desktop/scripts/run-electron-check.mjs project-references",
    "desktop:test-source-editor": "npm run desktop:build && node apps/desktop/scripts/run-electron-check.mjs source-editor",
    "desktop:test-search": "npm run desktop:build && node apps/desktop/scripts/run-electron-check.mjs search-filter",
    "desktop:test-environment-typography": "npm run desktop:build && node apps/desktop/scripts/run-electron-check.mjs environment-typography",
    "desktop:test-image-completion": "npm run desktop:build && node apps/desktop/scripts/run-electron-check.mjs image-completion",
    "desktop:test-table-editor": "npm run desktop:build && node apps/desktop/scripts/run-electron-check.mjs table-editor",
    "desktop:test-pdf-preview": "npm run desktop:build && node apps/desktop/scripts/run-electron-check.mjs pdf-preview",
    "desktop:test-multi-compile": "npm run desktop:build && node apps/desktop/scripts/run-electron-check.mjs multi-compile",
    "desktop:test-file-tree-state": "npm run desktop:build && node apps/desktop/scripts/run-electron-check.mjs file-tree-state",
    "desktop:test-preview-startup": "npm run desktop:build && node apps/desktop/scripts/run-electron-check.mjs preview-startup",
    "desktop:diagnose-preview": "npm run desktop:build && node apps/desktop/scripts/run-electron-check.mjs preview-diagnostics",
    "desktop:ai-probe": "npm run desktop:build && node apps/desktop/scripts/ai/probe.cjs",
    "desktop:test-preview-large": "npm run desktop:build && node apps/desktop/scripts/run-preview-large-check.mjs",
    "desktop:test-compiler-path": "npm run desktop:build && node apps/desktop/scripts/run-compile-path-check.mjs",
    "desktop:test-foundations": "npm run desktop:build && node apps/desktop/scripts/run-foundations-check.mjs",
    "desktop:test-spellcheck": "npm run desktop:build && node apps/desktop/scripts/run-spellcheck-check-launch.cjs",
    "verify": "npm run typecheck && npm run desktop:typecheck && npm run lint && npm run resources:validate && npm run test",
    "verify:release": "npm run verify && npm run desktop:test-regression"
  },
  "devDependencies": {
    "@electron/asar": "^3.2.18",
    "@eslint/js": "^9.35.0",
    "@monaco-editor/react": "^4.7.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.35.0",
    "esbuild": "^0.28.2",
    "monaco-editor": "^0.52.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.texweave.editor",
    "productName": "TeXWeave",
    "artifactName": "TeXWeave-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "apps/desktop/dist/**/*",
      "apps/desktop/package.json",
      "node_modules/**/*",
      "package.json",
      "LICENSE",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.d.cts"
    ],
    "extraFiles": [{ "from": "LICENSE", "to": "LICENSE" }],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      },
      {
        "from": "themes",
        "to": "themes"
      },
      {
        "from": "apps/desktop/scripts/uninstall-cleanup.cjs",
        "to": "uninstall-cleanup.cjs"
      }
    ],
    "win": {
      "icon": "resources/app-icon.ico",
      "signAndEditExecutable": false,
      "target": [{ "target": "portable", "arch": ["x64"] }]
    },
    "portable": {
      "artifactName": "TeXWeave-${version}-${arch}-portable.${ext}"
    },
    "nsis": {
      "artifactName": "TeXWeave-${version}-${arch}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.13",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "katex": "^0.18.7",
    "nspell": "^2.1.5",
    "pdfjs-dist": "^5.7.284"
  }
}
