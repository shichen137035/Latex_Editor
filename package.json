{
  "name": "latex-editor",
  "version": "0.5.3",
  "main": "apps/desktop/dist/main/index.js",
  "private": true,
  "description": "Local-first LaTeX editor foundation",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:compiler": "vitest run --project compiler",
    "test:cli": "vitest run --project cli-e2e",
    "resources:validate": "tsx apps/cli/src/index.ts resources validate",
    "doctor": "tsx apps/cli/src/index.ts doctor",
    "cli": "tsx apps/cli/src/index.ts",
    "desktop:typecheck": "npm exec tsc -- -p apps/desktop/tsconfig.json --noEmit --pretty false",
    "desktop:build": "npm run typecheck && npm run desktop:typecheck && vite build --config apps/desktop/vite.config.ts && tsc -p apps/desktop/tsconfig.main.json",
    "desktop:dist:win": "npm run desktop:build && node apps/desktop/scripts/build-distribution.cjs",
    "desktop:verify:package": "node apps/desktop/scripts/verify-package.cjs",
    "desktop:dev": "node apps/desktop/scripts/dev.cjs",
    "desktop:dev:build": "npm run desktop:build && node apps/desktop/scripts/launch.cjs",
    "desktop:test-ai": "npm run desktop:build && node apps/desktop/scripts/run-ai-connection-check.cjs",
    "desktop:test-ai-review": "npm run desktop:build && node apps/desktop/scripts/run-ai-review-check.mjs",
    "desktop:test-structure": "npm run desktop:build && node apps/desktop/scripts/run-structure-check.mjs",
    "desktop:test-ui": "npm run desktop:build && node apps/desktop/scripts/run-file-menu-check.mjs",
    "desktop:test-preview": "npm run desktop:build && node apps/desktop/scripts/run-preview-check.mjs",
    "desktop:test-preview-caret": "npm run desktop:build && node apps/desktop/scripts/run-preview-caret-check.mjs",
    "desktop:test-preview-startup": "npm run desktop:build && node apps/desktop/scripts/run-preview-startup-check.mjs",
    "desktop:test-preview-large": "npm run desktop:build && node apps/desktop/scripts/run-preview-large-check.mjs",
    "desktop:test-compiler-path": "npm run desktop:build && node apps/desktop/scripts/run-compile-path-check.mjs",
    "desktop:test-foundations": "npm run desktop:build && node apps/desktop/scripts/run-foundations-check.mjs",
    "desktop:test-spellcheck": "npm run desktop:build && node apps/desktop/scripts/run-spellcheck-check-launch.cjs",
    "verify": "npm run typecheck && npm run desktop:typecheck && npm run lint && npm run resources:validate && npm run test"
  },
  "devDependencies": {
    "@electron/asar": "^3.2.18",
    "@eslint/js": "^9.35.0",
    "@monaco-editor/react": "^4.7.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.35.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.texweave.editor",
    "productName": "TeXWeave",
    "artifactName": "TeXWeave-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "apps/desktop/build"
    },
    "files": [
      "apps/desktop/dist/**/*",
      "apps/desktop/src/preload/**/*",
      "apps/desktop/package.json",
      "packages/*/package.json",
      "packages/*/dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      },
      {
        "from": "themes",
        "to": "themes"
      },
      {
        "from": "build/manifests",
        "to": "resources/installer/manifests"
      },
      {
        "from": "build/profiles",
        "to": "resources/installer/profiles"
      },
      {
        "from": "build/scripts",
        "to": "resources/installer/scripts"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "TeXWeave-${version}-${arch}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "en_US",
        "zh_CN",
        "zh_TW",
        "ja_JP",
        "ko_KR",
        "fr_FR"
      ],
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "fileAssociations": [
      {
        "ext": "tex",
        "name": "LaTeX document",
        "description": "TeXWeave LaTeX document",
        "role": "Editor"
      }
    ],
    "portable": {
      "artifactName": "TeXWeave-${version}-${arch}-portable.${ext}"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.13",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "katex": "^0.18.7",
    "nspell": "^2.1.5",
    "pdfjs-dist": "^5.7.284"
  }
}
