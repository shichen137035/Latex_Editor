{
  "schemaVersion": 1,
  "policy": {
    "reuseExisting": true,
    "installOnlyMissing": true,
    "defaultDistribution": "texlive",
    "defaultProfile": "full",
    "externalRuntime": true,
    "removeExternalByDefault": false
  },
  "distributions": [
    { "id": "texlive", "displayName": "TeX Live", "bootstrapper": "https://mirror.ctan.org/systems/texlive/tlnet/install-tl-windows.exe", "profile": "profiles/texlive-full.profile" },
    { "id": "miktex", "displayName": "MiKTeX", "bootstrapper": "https://miktex.org/download/ctan/systems/win32/miktex/setup/windows-x64/basic-miktex-23.10.12.0.exe" }
  ],
  "requiredTools": ["latexmk", "pdflatex", "xelatex", "lualatex", "bibtex", "biber", "makeindex"]
}
