# TeXWeave default external TeX Live profile.
# The bootstrapper is downloaded and executed by the setup helper only after
# explicit user selection. The full scheme keeps package discovery predictable.
selected_scheme scheme-full
TEXDIR C:/texlive/texmf-local
TEXMFLOCAL C:/texlive/texmf-local
TEXMFSYSVAR C:/texlive/texmf-var
TEXMFCONFIG C:/texlive/texmf-config
option_doc 0
option_src 0
option_sys_bin 0
