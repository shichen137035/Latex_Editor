{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "types": [
      "node",
      "vite/client"
    ],
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "src/main/**/*.ts",
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/preload/**/*.cjs"
  ]
}
