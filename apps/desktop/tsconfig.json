{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "types": ["node", "vite/client"]
