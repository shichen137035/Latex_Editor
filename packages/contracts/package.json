{
  "name": "@latex-editor/contracts",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./desktop-ipc": {
      "types": "./dist/desktop-ipc.d.cts",
      "import": "./dist/desktop-ipc.cjs",
      "require": "./dist/desktop-ipc.cjs"
    },
    "./ai-paths": {
      "import": {
        "types": "./dist/ai-paths.d.ts",
        "default": "./dist/ai-paths.js"
      },
      "require": {
        "types": "./dist/ai-paths.d.cts",
        "default": "./dist/ai-paths.cjs"
      }
    },
    "./line-diff": {
      "types": "./dist/line-diff.d.cts",
      "import": "./dist/line-diff.cjs",
      "require": "./dist/line-diff.cjs"
    }
  }
}
