{
  "$schema": "../schemas/resource.schema.json",
  "schemaVersion": 1,
  "commands": [
    { "id": "latex.section", "name": "section", "insertText": "\\section{${1:title}}", "detail": "Section heading", "category": "structure" },
    { "id": "latex.subsection", "name": "subsection", "insertText": "\\subsection{${1:title}}", "detail": "Subsection heading", "category": "structure" },
    { "id": "latex.subsubsection", "name": "subsubsection", "insertText": "\\subsubsection{${1:title}}", "detail": "Subsubsection heading", "category": "structure" },
    { "id": "latex.chapter", "name": "chapter", "insertText": "\\chapter{${1:title}}", "detail": "Chapter heading", "category": "structure" },
    { "id": "latex.paragraph", "name": "paragraph", "insertText": "\\paragraph{${1:title}}", "detail": "Paragraph heading", "category": "structure" },
    { "id": "latex.textbf", "name": "textbf", "insertText": "\\textbf{${1:text}}", "detail": "Bold text", "category": "formatting" },
    { "id": "latex.textit", "name": "textit", "insertText": "\\textit{${1:text}}", "detail": "Italic text", "category": "formatting" },
    { "id": "latex.emph", "name": "emph", "insertText": "\\emph{${1:text}}", "detail": "Emphasized text", "category": "formatting" },
    { "id": "latex.underline", "name": "underline", "insertText": "\\underline{${1:text}}", "detail": "Underlined text", "category": "formatting" },
    { "id": "latex.texttt", "name": "texttt", "insertText": "\\texttt{${1:text}}", "detail": "Monospace text", "category": "formatting" },
    { "id": "latex.textsc", "name": "textsc", "insertText": "\\textsc{${1:text}}", "detail": "Small caps text", "category": "formatting" },
    { "id": "latex.frac", "name": "frac", "insertText": "\\frac{${1:numerator}}{${2:denominator}}", "detail": "Fraction", "category": "math" },
    { "id": "latex.sqrt", "name": "sqrt", "insertText": "\\sqrt{${1:expression}}", "detail": "Square root", "category": "math" },
    { "id": "latex.sum", "name": "sum", "insertText": "\\sum_{${1:i=1}}^{${2:n}}", "detail": "Summation", "category": "math" },
    { "id": "latex.prod", "name": "prod", "insertText": "\\prod_{${1:i=1}}^{${2:n}}", "detail": "Product", "category": "math" },
    { "id": "latex.int", "name": "int", "insertText": "\\int_{${1:a}}^{${2:b}} ${3:f(x)\\,dx}", "detail": "Integral", "category": "math" },
    { "id": "latex.lim", "name": "lim", "insertText": "\\lim_{${1:x \\to a}}", "detail": "Limit", "category": "math" },
    { "id": "latex.mathbb", "name": "mathbb", "insertText": "\\mathbb{${1:R}}", "detail": "Blackboard bold", "category": "math" },
    { "id": "latex.mathcal", "name": "mathcal", "insertText": "\\mathcal{${1:A}}", "detail": "Calligraphic math", "category": "math" },
    { "id": "latex.mathbf", "name": "mathbf", "insertText": "\\mathbf{${1:x}}", "detail": "Bold math", "category": "math" },
    { "id": "latex.operatorname", "name": "operatorname", "insertText": "\\operatorname{${1:op}}", "detail": "Named math operator", "category": "math" },
    { "id": "latex.label", "name": "label", "insertText": "\\label{${1:key}}", "detail": "Create a label", "category": "references" },
    { "id": "latex.ref", "name": "ref", "insertText": "\\ref{${1:key}}", "detail": "Reference a label", "category": "references" },
    { "id": "latex.eqref", "name": "eqref", "insertText": "\\eqref{${1:key}}", "detail": "Reference an equation", "category": "references" },
    { "id": "latex.autoref", "name": "autoref", "insertText": "\\autoref{${1:key}}", "detail": "Automatic reference", "category": "references" },
    { "id": "latex.cite", "name": "cite", "insertText": "\\cite{${1:key}}", "detail": "Citation", "category": "citations" },
    { "id": "latex.citet", "name": "citet", "insertText": "\\citet{${1:key}}", "detail": "Textual citation", "category": "citations" },
    { "id": "latex.citep", "name": "citep", "insertText": "\\citep{${1:key}}", "detail": "Parenthetical citation", "category": "citations" },
    { "id": "latex.citeauthor", "name": "citeauthor", "insertText": "\\citeauthor{${1:key}}", "detail": "Citation author", "category": "citations" },
    { "id": "latex.citeyear", "name": "citeyear", "insertText": "\\citeyear{${1:key}}", "detail": "Citation year", "category": "citations" },
    { "id": "latex.parencite", "name": "parencite", "insertText": "\\parencite{${1:key}}", "detail": "Parenthetical citation", "category": "citations" },
    { "id": "latex.textcite", "name": "textcite", "insertText": "\\textcite{${1:key}}", "detail": "Textual citation", "category": "citations" },
    { "id": "latex.input", "name": "input", "insertText": "\\input{${1:file}}", "detail": "Input a TeX file", "category": "files" },
    { "id": "latex.include", "name": "include", "insertText": "\\include{${1:file}}", "detail": "Include a TeX file", "category": "files" },
    { "id": "latex.includegraphics", "name": "includegraphics", "insertText": "\\includegraphics[${1:width=\\linewidth}]{${2:file}}", "detail": "Include an image", "category": "files" },
    { "id": "latex.bibliography", "name": "bibliography", "insertText": "\\bibliography{${1:file}}", "detail": "Use a BibTeX database", "category": "bibliography" },
    { "id": "latex.addbibresource", "name": "addbibresource", "insertText": "\\addbibresource{${1:file.bib}}", "detail": "Add a bibliography resource", "category": "bibliography" },
    { "id": "latex.documentclass", "name": "documentclass", "insertText": "\\documentclass{${1:article}}", "detail": "Select a document class", "category": "preamble" },
    { "id": "latex.usepackage", "name": "usepackage", "insertText": "\\usepackage{${1:package}}", "detail": "Load a package", "category": "preamble" },
    { "id": "latex.begin", "name": "begin", "insertText": "\\begin{${1}}", "detail": "Begin an environment", "category": "environment" },
    { "id": "latex.end", "name": "end", "insertText": "\\end{${1:environment}}", "detail": "End an environment", "category": "environment" },
    { "id": "latex.item", "name": "item", "insertText": "\\item ${1:text}", "detail": "List item", "category": "structure" },
    { "id": "latex.caption", "name": "caption", "insertText": "\\caption{${1:caption}}", "detail": "Figure or table caption", "category": "structure" },
    { "id": "latex.footnote", "name": "footnote", "insertText": "\\footnote{${1:note}}", "detail": "Footnote", "category": "formatting" },
    { "id": "latex.url", "name": "url", "insertText": "\\url{${1:https://example.com}}", "detail": "URL", "category": "formatting" }
  ]
}
